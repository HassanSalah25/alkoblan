APP_NAME="AL-KOBLAN Thermopipe Factory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
SUPPORTED_LOCALES=ar,en

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alkoblan_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@alkoblan.com.sa"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI Pipe Planner (OpenRouter) -------------------------------------------
# Server-side only. Never expose these to the frontend / VITE_ variables.
OPENROUTER_API_KEY=
# A vision-capable model id from https://openrouter.ai/models (input modalities
# must include "image"; models supporting "structured_outputs" are preferred).
# Verified at runtime; can be overridden in Admin > AI Pipe Planner > Settings.
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT=120
OPENROUTER_RETRIES=2
OPENROUTER_MAX_TOKENS=6000
PIPE_PLANNER_MAX_IMAGES=8
PIPE_PLANNER_MAX_IMAGE_KB=8192
PIPE_PLANNER_ANALYSES_PER_DAY=10
PIPE_PLANNER_MONTHLY_BUDGET_USD=50
PIPE_PLANNER_RETENTION_DAYS=90
PIPE_PLANNER_SHOW_PRICES=true
# queue = needs `php artisan queue:work` running; after_response = no worker needed
PIPE_PLANNER_DISPATCH=queue
